# Deployment-specific values for build-workflow.js. Copy to `.env` and fill in.
# `.env` is gitignored; this example is not. Nothing here is a credential —
# API keys, tokens and the Shopify secret live in n8n Credentials, never in a file.

# Base URL of your n8n instance, no trailing slash.
N8N_HOST=https://n8n.example.com

# Webhook path of the mock courier workflow (workflows/mock-courier.json), or set
# COURIER_URL directly to the real courier's endpoint. Use a long random segment:
# the mock's webhook has no authentication.
COURIER_PATH=courier-mock/v1/CHANGE-ME-LONG-RANDOM
# COURIER_URL=https://api.your-courier.dz/v1/parcels

# Webhook path of the demo trigger. Header Auth is attached to this node, but the
# path should still be unguessable.
DEMO_PATH=order-to-courier/demo/CHANGE-ME-LONG-RANDOM

# Telegram chat the alerts go to. A basic group upgraded to a supergroup changes
# its id from -123... to -100123... and the send starts failing.
TELEGRAM_CHAT_ID=-1001234567890
