# Copy to .env and fill locally. NEVER commit .env.
# These are placeholders only — no real values ever go in this repo.

# LLM provider (OpenAI-compatible endpoint; key goes in n8n Credentials only)
LLM_API_KEY=your-llm-api-key-here
LLM_BASE_URL=https://api.nanobridge.net
LLM_MODEL=deepseek-v4-flash

# n8n API (optional: workflow management from local tooling)
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=your-n8n-api-key-here

# Telegram (alert bot destination)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Free-tier APIs (keys only if the service requires one)
COINGECKO_DEMO_API_KEY=                  # CoinGecko free demo tier (optional but rate-limited nicer)
GOPPLUS_FREE=                            # GoPlus Security needs no key for low volume
BROWSERLESS_TOKEN=                       # optional screenshot service free tier
RESEND_API_KEY=                          # free transactional email (abandoned-cart demos)
